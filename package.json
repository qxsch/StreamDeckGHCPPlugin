{
	"name": "copilot-agents-streamdeck",
	"version": "1.0.0",
	"description": "Stream Deck plugin showing the status of running GitHub Copilot agent sessions in VS Code",
	"type": "module",
	"private": true,
	"scripts": {
		"images": "node tools/make-images.mjs",
		"build": "npm run images && rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.marcoweber.copilot-agents\"",
		"validate": "streamdeck validate com.marcoweber.copilot-agents.sdPlugin",
		"link": "streamdeck link com.marcoweber.copilot-agents.sdPlugin",
		"restart": "streamdeck restart com.marcoweber.copilot-agents",
		"probe": "tsc --outDir .probe --sourceMap false && node tools/probe.mjs",
		"preview": "tsc --outDir .probe --sourceMap false && node tools/preview.mjs",
		"test": "tsc --outDir .probe --sourceMap false && node tools/watch-test.mjs"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.2"
	},
	"devDependencies": {
		"@elgato/cli": "^1.9.0",
		"@rollup/plugin-commonjs": "^28.0.2",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-typescript": "^12.1.2",
		"@types/node": "^24.0.0",
		"rollup": "^4.34.0",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3"
	}
}

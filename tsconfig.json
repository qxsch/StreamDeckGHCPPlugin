{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"moduleDetection": "force",
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "com.marcoweber.copilot-agents.sdPlugin/bin"
	},
	"include": ["src/**/*"]
}
